{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoaseEdge/repo-governance/schemas/architecture-baseline.schema.json",
  "title": "repo-governance architecture baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contractSha256", "graphSha256", "healthScore", "architectureGraph", "metrics", "facts"],
  "properties": {
    "version": { "const": 1 },
    "contractSha256": { "$ref": "#/$defs/sha256" },
    "graphSha256": { "$ref": "#/$defs/sha256" },
    "healthScore": { "const": 100 },
    "architectureGraph": {
      "type": "object",
      "required": ["schemaVersion", "status", "contractPath", "nodes", "edges", "cycles", "skipped"],
      "properties": { "status": { "const": "evaluated" } }
    },
    "metrics": { "$ref": "#/$defs/metrics" },
    "facts": { "$ref": "#/$defs/facts" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "explicitLocalModuleCount", "layerDependencyCount", "moduleDependencyCount", "moduleImportCount", "fileCycleCount", "moduleCycleCount", "cycleCount", "boundaryViolationCount", "averageCoupling"],
      "properties": {
        "fileCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "explicitLocalModuleCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "layerDependencyCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "moduleDependencyCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "moduleImportCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "fileCycleCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "moduleCycleCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "cycleCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "boundaryViolationCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "averageCoupling": { "type": "number", "minimum": 0, "multipleOf": 0.001 }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
    },
    "moduleImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "file", "specifier"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "file": { "type": "string" },
        "specifier": { "type": "string" }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "nodes"],
      "properties": {
        "scope": { "enum": ["file", "module"] },
        "nodes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "boundaryViolation": {
      "type": "object",
      "required": ["code", "sourceFile", "sourceLayer", "sourceModule", "targetFile", "targetLayer", "targetModule", "targetIdentity", "dependencyType", "syntax", "specifier", "resolution"],
      "properties": {
        "code": { "type": "string" },
        "sourceFile": { "type": "string" },
        "sourceLayer": { "type": "string" },
        "sourceModule": { "type": ["string", "null"] },
        "targetFile": { "type": ["string", "null"] },
        "targetLayer": { "type": ["string", "null"] },
        "targetModule": { "type": ["string", "null"] },
        "targetIdentity": { "type": "string" },
        "dependencyType": { "type": "string" },
        "syntax": { "type": "string" },
        "specifier": { "type": "string" },
        "resolution": { "type": "string" }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layerDependencies", "moduleDependencies", "moduleImports", "cycles", "boundaryViolations"],
      "properties": {
        "layerDependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "moduleDependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "moduleImports": { "type": "array", "items": { "$ref": "#/$defs/moduleImport" } },
        "cycles": { "type": "array", "items": { "$ref": "#/$defs/cycle" } },
        "boundaryViolations": { "type": "array", "items": { "$ref": "#/$defs/boundaryViolation" } }
      }
    }
  }
}
