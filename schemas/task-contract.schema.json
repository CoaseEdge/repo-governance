{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoaseEdge/repo-governance/schemas/task-contract.schema.json",
  "title": "Repository task contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "objective", "allowedPaths", "forbiddenPaths", "budget"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "$ref": "#/$defs/taskId" },
    "objective": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathPattern" }
    },
    "forbiddenPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathPattern" }
    },
    "migrationPaths": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathPattern" }
    },
    "allowedChangeCategories": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/changeCategory" }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "subsystems": [],
        "sharedPaths": [],
        "ciReleasePaths": []
      },
      "properties": {
        "subsystems": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/subsystem" }
        },
        "sharedPaths": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathPattern" }
        },
        "ciReleasePaths": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathPattern" }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFiles"],
      "properties": {
        "maxFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maxDirectories": {
          "type": "integer",
          "minimum": 0
        },
        "maxMigrations": {
          "type": "integer",
          "minimum": 0
        },
        "maxOutOfScopeFiles": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "budget": { "required": ["maxMigrations"] }
        }
      },
      "then": {
        "required": ["migrationPaths"],
        "properties": {
          "migrationPaths": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "pathPattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "changeCategory": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "subsystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths"],
      "properties": {
        "id": { "$ref": "#/$defs/changeCategory" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathPattern" }
        }
      }
    }
  }
}
