{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoaseEdge/repo-governance/schemas/task-contract.schema.json",
  "title": "Repository task contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "objective", "allowedPaths", "forbiddenPaths", "budget"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "$ref": "#/$defs/taskId" },
    "objective": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathPattern" }
    },
    "forbiddenPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathPattern" }
    },
    "allowedChangeCategories": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/changeCategory" }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFiles"],
      "properties": {
        "maxFiles": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "pathPattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "changeCategory": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  }
}
