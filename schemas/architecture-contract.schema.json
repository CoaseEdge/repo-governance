{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoaseEdge/repo-governance/schemas/architecture-contract.schema.json",
  "title": "Repository architecture contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "architectureStyle", "layers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "architectureStyle": { "type": "string", "minLength": 1 },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layer" }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "pathPattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "dependencyIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "allowedDependencies", "forbiddenDependencies"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathPattern" }
        },
        "allowedDependencies": { "$ref": "#/$defs/dependencyIds" },
        "forbiddenDependencies": { "$ref": "#/$defs/dependencyIds" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "anyOf": [
        { "required": ["paths"] },
        { "required": ["imports"] }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathPattern" }
        },
        "imports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:@[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+|[A-Za-z0-9_.-]+)$"
          }
        }
      }
    }
  }
}
