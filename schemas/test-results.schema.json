{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoaseEdge/repo-governance/schemas/test-results.schema.json",
  "title": "Repository test results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tests"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tests": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/suiteId" },
      "additionalProperties": { "$ref": "#/$defs/suiteResults" }
    }
  },
  "$defs": {
    "suiteId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "suiteResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed"],
      "properties": {
        "failed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
